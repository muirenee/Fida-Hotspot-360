generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id         String     @id @default(uuid()) @db.Uuid
  name       String
  status     String     @default("active")
  createdAt  DateTime   @default(now())
  properties Property[]
  memberships Membership[]
}

model User {
  id          String       @id @default(uuid()) @db.Uuid
  subject     String       @unique
  memberships Membership[]
}
model Membership {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id])
  role        String
  active      Boolean  @default(true)
  propertyIds String[] @default([])
  @@unique([tenantId, userId])
  @@index([userId])
}
model Property {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @db.Uuid
  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  name      String
  timezone  String       @default("Africa/Kigali")
  createdAt DateTime     @default(now())
  gateways  Gateway[]
  plans     AccessPlan[]
  vouchers  Voucher[]
  @@unique([id, tenantId])
  @@index([tenantId])
}

model Gateway {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId, tenantId], references: [id, tenantId])
  name       String
  adapter    String
  status     String   @default("pending")
  lastSeenAt DateTime?
  @@unique([id, tenantId])
  @@index([tenantId, propertyId])
}

model AccessPlan {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  propertyId      String   @db.Uuid
  property        Property @relation(fields: [propertyId, tenantId], references: [id, tenantId])
  name            String
  downloadKbps    Int
  uploadKbps      Int
  durationSeconds Int
  quotaBytes      BigInt?
  maxDevices      Int      @default(1)
  vouchers        Voucher[]
  @@unique([id, tenantId])
  @@index([tenantId, propertyId])
}

model Voucher {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @db.Uuid
  propertyId   String     @db.Uuid
  property     Property   @relation(fields: [propertyId, tenantId], references: [id, tenantId])
  accessPlanId String     @db.Uuid
  accessPlan   AccessPlan @relation(fields: [accessPlanId, tenantId], references: [id, tenantId])
  codeHash     String     @unique
  status       String     @default("unused")
  expiresAt    DateTime?
  redeemedAt   DateTime?
  createdAt    DateTime   @default(now())
  @@index([tenantId, propertyId, status])
}
